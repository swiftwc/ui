{
  "name": "@swiftwc/ui",
  "version": "1.0.0",
  "description": "Elegant SwiftUI-inspired web components for standalone web apps and web extensions.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "The SwiftWC/UI Authors",
    "url": "https://github.com/swiftwc/ui/graphs/contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftwc/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/swiftwc/ui/issues"
  },
  "files": [
    "generated",
    "scss",
    "html-data",
    "css-data",
    "custom-elements"
  ],
  "sass": "scss/index.scss",
  "keywords": [
    "components",
    "ui",
    "swift"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "default": "./generated/index.js"
    },
    "./components": {
      "types": "./generated/components/index.d.ts",
      "default": "./generated/components/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./events": {
      "types": "./generated/events/index.d.ts",
      "default": "./generated/events/index.js"
    },
    "./css": "./generated/css/index.css",
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*.scss",
    "./customElements/en": "./custom-elements/en.json",
    "./HTMLData/en": "./html-data/en.json",
    "./CSSData/en": "./css-data/en.json"
  },
  "bin": {
    "swiftwc": "./generated/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ts && npm run build:scss",
    "postbuild": "node -e \"const fs=require('node:fs');const f='./generated/internal/dev-flags.js';const s=fs.readFileSync(f,'utf8');fs.writeFileSync(f,s.replace(/DEBUG:\\s*(true|false)/, 'DEBUG: false'))\"",
    "build:ts": "tsc",
    "build:ts:watch": "tsc --watch",
    "build:scss": "sass --style=expanded --no-source-map scss/index.scss generated/css/index.css",
    "build:scss:watch": "true",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf generated",
    "codegen": "npm run codegen:manifest && npm run barrelize",
    "codegen:manifest": "node scripts/make-manifest.mts && prettier --write ./custom-elements/en.json ./html-data/en.json ./css-data/en.json",
    "barrelize": "npm run barrelize:components && npm run barrelize:events && npm run barrelize:buses && npm run barrelize:i18n && npm run barrelize:tpl && npm run barrelize:morphdom && npm run barrelize:decorators && npm run barrelize:utils",
    "barrelize:components": "node scripts/barrelize.mts js/components",
    "barrelize:events": "node scripts/barrelize.mts js/events",
    "barrelize:buses": "node scripts/barrelize.mts js/buses --exportDefault",
    "barrelize:i18n": "node scripts/barrelize.mts js/i18n/locales --exportDefault --fullPathname",
    "barrelize:tpl": "node scripts/barrelize.mts js/tpl --exportDefault",
    "barrelize:morphdom": "node scripts/barrelize.mts js/morphdom --exportDefault",
    "barrelize:decorators": "node scripts/barrelize.mts js/internal/decorators --exportDefault",
    "barrelize:utils": "node scripts/barrelize.mts js/internal/utils --exportDefault",
    "verify": "npm run codegen && npm run lint && npm run test && npm run build",
    "lint": "npm run lint:types && npm run lint:types:scripts && npm run lint:types:test && npm run lint:js && npm run lint:scss && npm run lint:format",
    "lint:fix": "npm run lint:js:fix && npm run format",
    "lint:types": "tsc --noEmit",
    "lint:types:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "lint:types:test": "tsc -p tsconfig.test.json --noEmit && tsc -p scss/tsconfig.json --noEmit",
    "lint:js": "true",
    "lint:js:fix": "true",
    "lint:scss": "sass --no-source-map scss/index.scss > /dev/null",
    "lint:format": "prettier . --cache --check",
    "format": "prettier . --cache --write",
    "test": "vitest run --config .config/vitest/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest/vitest.config.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@vitest/browser-playwright": "^4.1.12",
    "doctrine": "^3.0.0",
    "es-toolkit": "^1.53.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "sass": "^1.98.0",
    "sass-true": "^10.1.0",
    "ts-morph": "^28.0.0",
    "vitest": "^4.1.12"
  },
  "customElements": "custom-elements/en.json"
}
