{
  "name": "@swiftwc/ui",
  "version": "1.0.0",
  "description": "Elegant SwiftUI-inspired web components for standalone web apps and web extensions.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "The SwiftWC/UI Authors",
    "url": "https://github.com/swiftwc/ui/graphs/contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftwc/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/swiftwc/ui/issues"
  },
  "files": [
    "generated",
    "scss",
    "html-data",
    "css-data"
  ],
  "sass": "scss/index.scss",
  "keywords": [
    "components",
    "ui",
    "swift"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "default": "./generated/index.js"
    },
    "./components": {
      "types": "./generated/components/index.d.ts",
      "default": "./generated/components/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./events": {
      "types": "./generated/events/index.d.ts",
      "default": "./generated/events/index.js"
    },
    "./css": "./generated/css/index.css",
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*.scss",
    "./customElements/en": "./custom-elements/en.json",
    "./HTMLData/en": "./html-data/en.json",
    "./CSSData/en": "./css-data/en.json"
  },
  "bin": {
    "swiftwc": "./generated/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ts && npm run build:scss",
    "postbuild": "node -e \"const fs=require('node:fs');const f='./generated/internal/dev-flags.js';const s=fs.readFileSync(f,'utf8');fs.writeFileSync(f,s.replace(/DEBUG:\\s*(true|false)/, 'DEBUG: false'))\"",
    "clean": "rm -rf generated",
    "build:ts": "tsc",
    "build:ts:watch": "npm run clean && tsc --watch",
    "build:scss": "sass --style=expanded --no-source-map scss/index.scss generated/css/index.css",
    "prepublishOnly": "npm run build",
    "codegen": "npm run codegen:manifest && npm run codegen:barrelize",
    "codegen:manifest": "tsx scripts/make-manifest.ts && prettier ./html-data/en.json && prettier ./css-data/en.json --write",
    "codegen:barrelize": "npm run codegen:barrelize:components && npm run codegen:barrelize:events && npm run codegen:barrelize:buses && npm run codegen:barrelize:i18n && npm run codegen:barrelize:tpl && npm run codegen:barrelize:morphdom && npm run codegen:barrelize:decorators && npm run codegen:barrelize:utils",
    "codegen:barrelize:components": "node scripts/barrelize.mts js/components",
    "codegen:barrelize:events": "node scripts/barrelize.mts js/events",
    "codegen:barrelize:buses": "node scripts/barrelize.mts js/buses --exportDefault",
    "codegen:barrelize:i18n": "node scripts/barrelize.mts js/i18n/locales --exportDefault --fullPathname",
    "codegen:barrelize:tpl": "node scripts/barrelize.mts js/tpl --exportDefault",
    "codegen:barrelize:morphdom": "node scripts/barrelize.mts js/morphdom --exportDefault",
    "codegen:barrelize:decorators": "node scripts/barrelize.mts js/internal/decorators --exportDefault",
    "codegen:barrelize:utils": "node scripts/barrelize.mts js/internal/utils --exportDefault",
    "verify": "npm run codegen && npm run lint:types && npm run format && npm run test",
    "format": "prettier . --write",
    "lint": "prettier . --check",
    "lint:types": "tsc --noEmit && sass --no-source-map scss/index.scss > /dev/null",
    "lint:types:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --config .config/vitest/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest/vitest.config.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@vitest/browser-playwright": "^4.1.12",
    "doctrine": "^3.0.0",
    "es-toolkit": "^1.53.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "sass": "^1.98.0",
    "sass-true": "^10.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.12"
  },
  "customElements": "custom-elements/en.json"
}
