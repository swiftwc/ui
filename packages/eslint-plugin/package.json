{
  "name": "@swiftwc/eslint-plugin",
  "version": "1.1.7",
  "description": "Rules enforcing best practices while using SwiftWC.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": {
    "name": "The SwiftWC/UI Authors",
    "url": "https://github.com/swiftwc/ui/graphs/contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftwc/ui.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/swiftwc/ui/issues"
  },
  "type": "module",
  "peerDependencies": {
    "@swiftwc/ui": "^1.0.0",
    "eslint": ">=10.0.0"
  },
  "exports": {
    "./html/en": "./generated/html/en.js",
    "./emberjs/en": "./generated/emberjs/en.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ts",
    "build:ts": "tsc",
    "build:ts:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf generated",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:format",
    "lint:fix": "npm run lint:js:fix && npm run format",
    "lint:types": "tsc --noEmit",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --cache --fix",
    "lint:format": "prettier . --cache --check",
    "format": "prettier . --cache --write"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "^8.59.2"
  }
}
