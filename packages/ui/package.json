{
  "name": "@swiftwc/ui",
  "version": "1.0.0-canary.4",
  "description": "Elegant SwiftUI-inspired web components for standalone web apps and web extensions.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "The SwiftWC/UI Authors",
    "url": "https://github.com/swiftwc/ui/graphs/contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftwc/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/swiftwc/ui/issues"
  },
  "files": [
    "generated",
    "scss",
    "html-data",
    "css-data"
  ],
  "sass": "scss/index.scss",
  "keywords": [
    "components",
    "ui",
    "swift"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "default": "./generated/index.js"
    },
    "./components": {
      "types": "./generated/components/index.d.ts",
      "default": "./generated/components/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./events": {
      "types": "./generated/events/index.d.ts",
      "default": "./generated/events/index.js"
    },
    "./css": "./generated/css/index.css",
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*.scss",
    "./customElements/en": "./custom-elements/en.json",
    "./HTMLData/en": "./html-data/en.json",
    "./CSSData/en": "./css-data/en.json"
  },
  "bin": {
    "swiftwc": "./generated/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf generated",
    "build": "npm run build:ts && npm run build:scss && npm run debug:off",
    "build:ts": "tsc",
    "build:ts:watch": "npm run prebuild && tsc --watch",
    "build:scss": "sass --style=expanded --no-source-map scss/index.scss generated/css/index.css",
    "debug:off": "node -e \"const fs=require('node:fs');const f='./generated/internal/dev-flags.js';const s=fs.readFileSync(f,'utf8');fs.writeFileSync(f,s.replace(/DEBUG:\\s*(true|false)/, 'DEBUG: false'))\"",
    "prepublishOnly": "npm run build",
    "codegen": "npm run codegen:manifest && npm run codegen:barrelize",
    "codegen:manifest": "tsx scripts/make-manifest.ts && prettier ./html-data/en.json && prettier ./css-data/en.json --write",
    "codegen:barrelize": "npm run codegen:barrelize:components && npm run codegen:barrelize:events && npm run codegen:barrelize:buses && npm run codegen:barrelize:i18n && npm run codegen:barrelize:tpl && npm run codegen:barrelize:morphdom && npm run codegen:barrelize:decorators && npm run codegen:barrelize:utils",
    "codegen:barrelize:components": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --directory ./js/components --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:events": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --directory ./js/events --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:buses": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --directory ./js/buses --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:i18n": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --fullPathname --directory ./js/i18n/locales --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:tpl": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --directory ./js/tpl --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:morphdom": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --directory ./js/morphdom --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:decorators": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --directory ./js/internal/decorators --exclude \".\\.test\\.ts\"",
    "codegen:barrelize:utils": "barrelsby --noHeader --delete --singleQuotes --noSemicolon --exportDefault --directory ./js/internal/utils --exclude \".\\.test\\.ts\"",
    "verify": "npm run codegen && npm run lint:types && npm run format && vitest run --dom",
    "lint": "prettier . --check",
    "lint:types": "tsc --noEmit && sass --no-source-map scss/index.scss > /dev/null",
    "lint:types:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "format": "prettier . --write",
    "test": "vitest --dom",
    "version:pkg": "npm version $npm_config_bump --no-git-tag-version --preid=dev"
  },
  "devDependencies": {
    "doctrine": "^3.0.0",
    "element-internals-polyfill": "^3.0.2",
    "gonzales-pe": "^4.3.0",
    "happy-dom": "^20.7.0",
    "sass": "^1.98.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  },
  "customElements": "custom-elements/en.json"
}
