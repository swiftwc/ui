{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "outDir": "generated",
    "rootDir": "js",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "experimentalDecorators": true
  },
  "include": ["js"],
  "exclude": ["**/*.test.ts"]
}
